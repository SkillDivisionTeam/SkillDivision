# === Database (PostgreSQL) ===
POSTGRES_DB=skilldivision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db

# === Django ===
DJANGO_SECRET_KEY=change-me-generate-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost

# === Telegram Bot ===
TG_TOKEN=your-telegram-bot-token
BACKEND_API_URL=http://backend:8000/api

# === AI ===
GIGACHAT_TOKEN=your-gigachat-credentials
GEMINI_API_KEY=your-gemini-api-key

# === Frontend ===
# Dev: прямой доступ к backend
VITE_API_URL=http://localhost:8000/api
# Prod (docker-compose.prod.yml): относительный путь через Nginx
# VITE_API_URL=/api

# === pgAdmin (только dev, docker-compose.yml) ===
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me
